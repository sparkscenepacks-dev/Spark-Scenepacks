{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/requests", "destination": "/requests.html" },
    { "source": "/auth", "destination": "/auth.html" },
    { "source": "/donate", "destination": "/donate.html" },
    { "source": "/legal", "destination": "/legal.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/downloadsite", "destination": "/downloadsite.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
