{
  "version": 2,
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/requests", "dest": "/requests.html" },
    { "src": "/auth", "dest": "/auth.html" },
    { "src": "/donate", "dest": "/donate.html" },
    { "src": "/legal", "dest": "/legal.html" },
    { "src": "/terms", "dest": "/terms.html" },
    { "src": "/downloadsite", "dest": "/downloadsite.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}